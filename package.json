{
  "name": "shopify-admin-mcp",
  "version": "0.1.5",
  "description": "MCP server for Shopify Admin GraphQL API",
  "main": "dist/index.js",
  "bin": {
    "shopify-admin-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "shopify",
    "admin",
    "graphql",
    "claude",
    "anthropic"
  ],
  "author": "Michael Reimer <michael.reimer@mayuno.ch>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAYUNO-International-LLC/shopify-admin-mcp.git"
  },
  "homepage": "https://github.com/MAYUNO-International-LLC/shopify-admin-mcp#readme",
  "bugs": {
    "url": "https://github.com/MAYUNO-International-LLC/shopify-admin-mcp/issues"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
